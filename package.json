{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001 --strictPort",
    "build": "vite build",
    "start": "vite preview --port 3001 --strictPort",
    "deploy": "vite build && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "db:seed:local": "wrangler d1 execute portfolio-db --local --file=migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute portfolio-db --remote --file=migrations/seed.sql"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-router": "^1.142.11",
    "@tanstack/react-start": "^1.142.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.482.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.69.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^2.15.4",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-toc": "^9.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/router-generator": "^1.142.11",
    "@tanstack/router-plugin": "^1.142.11",
    "@types/node": "^20",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.41.0"
  }
}
